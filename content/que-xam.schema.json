{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "que-xam.schema.json",
  "title": "Quẻ xăm Chùa An Nhiên",
  "type": "array",
  "minItems": 100,
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "tieuDe",
      "tho",
      "loiGiai",
      "loiGiaiTheoChuDe",
      "loiKhuyen",
      "chuDe",
      "ghiChu"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "tieuDe": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      },
      "tho": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "string",
          "minLength": 10,
          "maxLength": 90
        }
      },
      "loiGiai": {
        "type": "string",
        "minLength": 100,
        "maxLength": 800
      },
      "loiGiaiTheoChuDe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gia-dao",
          "cong-viec",
          "suc-khoe",
          "hoc-hanh",
          "tinh-duyen",
          "tai-loc"
        ],
        "properties": {
          "gia-dao": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          },
          "cong-viec": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          },
          "suc-khoe": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          },
          "hoc-hanh": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          },
          "tinh-duyen": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          },
          "tai-loc": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          }
        }
      },
      "loiKhuyen": {
        "type": "string",
        "minLength": 20,
        "maxLength": 300
      },
      "chuDe": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "enum": [
            "gia-dao",
            "cong-viec",
            "suc-khoe",
            "hoc-hanh",
            "tinh-duyen",
            "tai-loc"
          ]
        }
      },
      "ghiChu": {
        "type": "string",
        "minLength": 10,
        "maxLength": 200
      }
    }
  }
}
