{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "su-kien-am-lich.schema.json",
  "title": "Sự kiện âm lịch",
  "type": "array",
  "minItems": 15,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "ten",
      "loai",
      "thang",
      "ngay",
      "moTa",
      "trangTri",
      "nhiemVu"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "ten": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      },
      "loai": {
        "enum": [
          "phat-giao",
          "dan-gian"
        ]
      },
      "thang": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "maximum": 12
      },
      "ngay": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      },
      "moTa": {
        "type": "string",
        "minLength": 50,
        "maxLength": 600
      },
      "trangTri": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        }
      },
      "nhiemVu": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        }
      },
      "ghiChu": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
